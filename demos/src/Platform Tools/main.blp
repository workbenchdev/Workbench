using Gtk 4.0;
using Adw 1;

Adw.StatusPage {
  title: _("Platform Tools");

  Box {
    orientation: vertical;

    Box {
      orientation: vertical;
      halign: center;

      Button adwaita-1-demo {
        label: _("Adwaita Demo");
        action-name: "app.platform_tools";
        action-target: "'adwaita-1-demo'";

        styles [
          "pill",
        ]
      }

      LinkButton {
        styles [
          "caption",
        ]

        margin-bottom: 30;
        label: _("Source Code");
        uri: "https://gitlab.gnome.org/GNOME/libadwaita/-/tree/1.5.0/demo";
      }

      Button gtk4-demo {
        label: _("GTK Demo");
        action-name: "app.platform_tools";
        action-target: "'gtk4-demo'";

        styles [
          "pill",
        ]
      }

      LinkButton {
        styles [
          "caption",
        ]

        margin-bottom: 30;
        label: _("Source Code");
        uri: "https://gitlab.gnome.org/GNOME/gtk/-/tree/4.14.2/demos/gtk-demo";
      }

      Button gtk4-widget-factory {
        label: _("GTK Widget Factory");
        action-name: "app.platform_tools";
        action-target: "'gtk4-widget-factory'";

        styles [
          "pill",
        ]
      }

      LinkButton {
        styles [
          "caption",
        ]

        margin-bottom: 30;
        label: _("Source Code");
        uri: "https://gitlab.gnome.org/GNOME/gtk/-/tree/4.14.2/demos/widget-factory";
      }
    }

    Box {
      halign: center;
      orientation: vertical;

      Label {
        label: _(
          "As with most GTK applications, you can use the keyboard shortcut\nto open the Inspector and select an object to see what it is made of:"
        );
        justify: center;

        styles [
          "body",
        ]
      }

      ShortcutsShortcut {
        halign: center;
        accelerator: "<Control><Shift>I";
        margin-top: 6;
      }

      LinkButton {
        margin-top: 6;
        halign: center;
        label: _("The GTK Inspector");
        uri: "https://developer.gnome.org/documentation/tools/inspector.html";
      }
    }
  }
}
